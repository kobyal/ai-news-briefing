direction: right
task: Task
context: Context (AGENTS.md + rules)
model: Model
tools: Tools in sandbox
checks: Checks (lint, tests, hooks)
done: Done
rules: New rule
task -> context: loaded
context -> model: prompt
model -> tools: calls
tools -> checks: output
checks -> done: pass
checks -> model: fail + error
checks -> rules: new mistake
rules -> context: next session
