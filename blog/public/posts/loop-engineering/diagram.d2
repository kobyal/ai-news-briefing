direction: down
goal: "Goal + NOTES.md"
turn: "Agent turn (max-turns 20)"
check: "make test (exit code)"
done: "Done, fresh-context review"
notes: "Log failure"
budget: "Round budget (MAX=8)"
human: "Stop, human looks"
goal -> turn
turn -> check
check -> done: "exit 0"
check -> notes: "exit != 0"
notes -> budget
budget -> goal: "rounds left"
budget -> human: "out of budget"
