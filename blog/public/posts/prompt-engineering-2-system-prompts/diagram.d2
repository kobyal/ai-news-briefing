direction: down
tools: Tools
system: System prompt (static)
bp: Cache breakpoint
msgs: User message (time, user, trace)
check: Prefix lookup
hit: Cache read 0.1x
miss: Cache write 1.25x
model: Model
tools -> system: prefix order
system -> bp: cache_control
bp -> check
check -> hit: same bytes
check -> miss: any byte changed
hit -> model
miss -> model
msgs -> model: not cached
