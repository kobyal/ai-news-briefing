direction: down
goal: Goal from human
plan: Model picks next step
tool: Harness runs tool
observe: Result into context
verify: Verifier and budget check
done: Done
stop: Stop at max_steps or budget
human: Human approval
goal -> plan: goal, not instructions
plan -> tool: tool + args
plan -> human: write action
human -> tool: approved
tool -> observe: output
observe -> verify: check
verify -> plan: not done
verify -> done: passes
verify -> stop: limit hit
