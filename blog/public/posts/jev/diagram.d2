direction: right
state: "State + typed questions"
pass: "Single forward pass"
logits: "Logits over option tokens"
norm: "Renormalize to probabilities"
cal: "Calibration (RLCD)"
th: "Threshold"
act: "Code acts"
esc: "Human review"
state -> pass
pass -> logits: "one step, no generation"
logits -> norm
norm -> cal
cal -> th
th -> act: "p >= 0.8"
th -> esc: "p < 0.8"
