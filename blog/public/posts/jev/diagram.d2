direction: right
state: "State (text / JSON)"
questions: "Typed questions + options"
fp: "Single forward pass"
logits: "Logits on option tokens"
norm: "Normalize to probabilities"
decision: "Typed decision + confidence"
gate: "Threshold"
act: "Act automatically"
review: "Escalate to human"
state -> fp
questions -> fp
fp -> logits
logits -> norm
norm -> decision
decision -> gate
gate -> act: "p >= 0.95"
gate -> review: "p < 0.95"
