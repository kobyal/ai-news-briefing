---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { fmtDate, readingMinutes, t, type Lang } from '../lib/i18n';
import { marked } from 'marked';

interface Props { lang: Lang; post: CollectionEntry<'posts'> }
const { lang, post } = Astro.props;
const s = t(lang);
const d = post.data;
const { Content } = await render(post);
const opinionHtml = marked.parse(d.opinion);
const minutes = readingMinutes(post.body ?? '');
const path = lang === 'he' ? `/${d.key}/` : `/en/${d.key}/`;
const site = 'https://blog.aibriefing.dev';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  inLanguage: lang === 'he' ? 'he-IL' : 'en-US',
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  image: d.hero ? site + d.hero : undefined,
  url: site + path,
  author: { '@type': 'Person', name: 'Koby Almog', url: 'https://aibriefing.dev/about/', image: 'https://aibriefing.dev/koby-almog.jpg' },
  publisher: { '@type': 'Organization', name: 'AI Briefing', url: 'https://aibriefing.dev' },
  keywords: [d.term, ...d.tags].join(', '),
  citation: d.sources.map((x) => x.url),
};
---
<Base lang={lang} title={`${d.title} — AI Briefing Blog`} description={d.description} image={d.hero} type="article" jsonLd={jsonLd}>
  <main class="wrap article">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">
      <span class="term-pill" dir="ltr">{d.term}</span>
      <span class="meta">{fmtDate(d.pubDate, lang)} · {minutes} {s.minutes}</span>
    </div>
    <h1>{d.title}</h1>
    <p class="lede">{d.description}</p>

    {d.hero && !d.video && (
      <figure style="margin-top:8px">
        <img src={d.hero} alt="" width="1200" height="630" />
      </figure>
    )}

    {d.video && (
      <div class="video-wrap">
        <video controls preload="metadata" poster={d.videoPoster ?? d.hero} playsinline>
          <source src={d.video} type="video/mp4" />
        </video>
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    <aside class="opinion">
      <div class="label">{s.opinionLabel}</div>
      <Fragment set:html={opinionHtml} />
    </aside>

    <section class="card sources">
      <h2>{s.sourcesLabel}</h2>
      <ol>
        {d.sources.map((src) => (
          <li><a href={src.url} rel="noopener noreferrer" target="_blank" dir="ltr">{src.title}</a>{src.date && <span class="d"> · {src.date}</span>}</li>
        ))}
      </ol>
    </section>

    <div class="made-with">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 2l2.4 5.6L20 9l-4.5 4 1.3 6-4.8-3-4.8 3 1.3-6L4 9l5.6-1.4z"/></svg>
      <span>{s.madeWith.replace('{n}', String(d.madeWith.sourceCount))}</span>
    </div>

    <div class="card author">
      <img src="https://aibriefing.dev/koby-almog.jpg" alt="Koby Almog" width="56" height="56" />
      <div>
        <div class="n">{lang === 'he' ? 'קובי אלמוג' : 'Koby Almog'}</div>
        <div class="r">{s.authorRole} · <a href="https://aibriefing.dev/about/">{s.about}</a></div>
      </div>
    </div>
  </main>
</Base>
