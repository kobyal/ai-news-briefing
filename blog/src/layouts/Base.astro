---
import '../styles/global.css';
import { t, altLangHref } from '../lib/i18n';

interface Props {
  lang: 'he' | 'en';
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  altHref?: string;       // same page in the other language
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}
const { lang, title, description, image = '/og-default.jpg', canonical, altHref, type = 'website', jsonLd } = Astro.props;
const dir = lang === 'he' ? 'rtl' : 'ltr';
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://blog.aibriefing.dev';
const url = canonical ?? new URL(Astro.url.pathname, site).toString();
const other = altHref ?? altLangHref(Astro.url.pathname, lang);
const s = t(lang);
---
<!doctype html>
<html lang={lang === 'he' ? 'he-IL' : 'en-US'} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang={lang === 'he' ? 'en' : 'he'} href={new URL(other, site).toString()} />
    <link rel="alternate" hreflang={lang} href={url} />
    <link rel="alternate" type="application/rss+xml" title="AI Briefing Blog" href={lang === 'he' ? '/rss.xml' : '/en/rss.xml'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#12121c" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="AI Briefing Blog" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(image, site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'he' ? 'he_IL' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="masthead">
      <div class="wrap-wide bar">
        <a class="brand" href={lang === 'he' ? '/' : '/en/'}>
          <span class="name" dir="ltr">AI Briefing</span><span class="sep">/</span><span class="blog">{s.blog}</span>
        </a>
        <nav class="nav">
          <a class="hide-sm" href="https://aibriefing.dev/">{s.dailyBriefing}</a>
          <a class="hide-sm" href="https://aibriefing.dev/about/">{s.about}</a>
          <span class="lang-toggle" dir="ltr">
            <a href={lang === 'en' ? Astro.url.pathname : other} class={lang === 'en' ? 'on' : ''}>EN</a>
            <a href={lang === 'he' ? Astro.url.pathname : other} class={lang === 'he' ? 'on' : ''}>עב</a>
          </span>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap-wide row">
        <span><a class="name" href="https://aibriefing.dev/" dir="ltr">AI Briefing</a> &nbsp;·&nbsp; {s.footerLine}</span>
        <span><a href={lang === 'he' ? '/rss.xml' : '/en/rss.xml'}>RSS</a> &nbsp;·&nbsp; <a href="https://aibriefing.dev/about/">Koby Almog</a></span>
      </div>
    </footer>
  </body>
</html>
