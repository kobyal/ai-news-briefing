direction: down
task: "Task + verify command"
local: "Local model (qwen2.5-coder:7b)"
patch: "Full new file"
verify: "Run verify (pytest / cargo test)"
done: "exit 0: keep and stop"
revert: "git checkout the file"
big: "Large model, same verify"
task -> local: "file + last 60 log lines"
local -> patch: "one code block"
patch -> verify: "timeout 120s"
verify -> done: "exit 0"
verify -> local: "exit != 0, tries < 3"
verify -> revert: "3rd failure"
revert -> big: "escalate"
