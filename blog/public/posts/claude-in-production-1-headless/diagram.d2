direction: right
step: pipeline step
wrap: anthropic_cc wrapper
cli: claude -p --output-format json
envelope: envelope (is_error, result, cost)
repair: extract_json
ok: validated output
retry: backoff + retry
fail: raise and quarantine
step -> wrap: prompt (sanitized)
wrap -> cli: clean env, timeout
cli -> envelope: stdout
envelope -> repair: result string
repair -> ok: parsed
envelope -> retry: transient error
retry -> cli: attempt n+1
envelope -> fail: refusal or hook block
repair -> fail: no JSON
