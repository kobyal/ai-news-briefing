---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import SeriesNav from './SeriesNav.astro';
import { fmtDate, postHref, readingMinutes, t, type Lang } from '../lib/i18n';
import { marked } from 'marked';

interface Props { lang: Lang; post: CollectionEntry<'posts'> }
const { lang, post } = Astro.props;
const s = t(lang);
const d = post.data;
const { Content, headings } = await render(post);
const opinionHtml = marked.parse(d.opinion);
const words = (post.body ?? '').split(/\s+/).length;
const minutes = readingMinutes(post.body ?? '');
const toc = words > 1100 ? headings.filter((h) => h.depth === 2) : [];
const path = postHref(lang, d.key);
const site = 'https://blog.aibriefing.dev';
const related = (await getCollection('posts', (p) => p.data.lang === lang && !p.data.draft && p.data.key !== d.key && p.data.series?.slug !== d.series?.slug))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  inLanguage: lang === 'he' ? 'he-IL' : 'en-US',
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  image: d.hero ? site + d.hero : undefined,
  url: site + path,
  author: { '@type': 'Person', name: 'Koby Almog', url: 'https://aibriefing.dev/about/', image: 'https://aibriefing.dev/koby-almog.jpg' },
  publisher: { '@type': 'Organization', name: 'AI Briefing', url: 'https://aibriefing.dev' },
  keywords: [d.term, ...d.tags].join(', '),
  citation: d.sources.map((x) => x.url),
  ...(d.series ? { isPartOf: { '@type': 'CreativeWorkSeries', name: d.series.name, url: site + (lang === 'he' ? `/series/${d.series.slug}/` : `/en/series/${d.series.slug}/`) }, position: d.series.part } : {}),
};
---
<Base lang={lang} title={`${d.title} — AI Briefing Blog`} description={d.description} image={d.hero} type="article" jsonLd={jsonLd}>
  <main class={`wrap article kind-${d.kind}`}>
    {d.series && <SeriesNav lang={lang} post={post} />}
    <div class="byline mono"><span class="term">{d.term}</span><span class="dot">·</span><span>{fmtDate(d.pubDate, lang)}</span><span class="dot">·</span><span>{minutes} {s.minutes}</span></div>
    <h1>{d.title}</h1>
    <p class="lede">{d.description}</p>

    {d.hero && !d.video && (
      <div class="cover"><img src={d.hero} alt="" width="1200" height="630" /></div>
    )}

    {d.video && (
      <div class="video-wrap">
        <video controls preload="metadata" poster={d.videoPoster ?? d.hero} playsinline>
          <source src={d.video} type="video/mp4" />
        </video>
      </div>
    )}

    {d.kind === 'fieldnotes' && (
      <nav class="steps-rail">
        {headings.filter((h) => h.depth === 2 && /^\d{2} · /.test(h.text)).map((h) => (
          <a href={`#${h.slug}`}><b>{h.text.slice(0, 2)}</b><span>{h.text.slice(5)}</span></a>
        ))}
      </nav>
    )}
    {d.kind === 'faq' && (
      <nav class="faq-index">
        <div class="label mono">{s.contents}</div>
        <ol>{headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    {d.kind === 'warstory' && d.tldr.length > 0 && (
      <ol class="incident-strip">{d.tldr.map((x, i) => <li><b class="mono">{String(i + 1).padStart(2, '0')}</b><span>{x}</span></li>)}</ol>
    )}
    {d.kind === 'deepdive' && d.tldr.length > 0 && (
      <aside class="spec">
        <div class="label mono">{d.term}</div>
        <ul>{d.tldr.map((x) => <li>{x}</li>)}</ul>
        <div class="links mono">{d.sources.slice(0, 3).map((x) => <a href={x.url} target="_blank" rel="noopener noreferrer" dir="ltr">{new URL(x.url).hostname.replace(/^www\./, '')}</a>)}</div>
      </aside>
    )}
    {d.kind === 'explainer' && d.tldr.length > 0 && (
      <aside class="tldr">
        <div class="label mono">{s.tldr}</div>
        <ul>{d.tldr.map((x) => <li>{x}</li>)}</ul>
      </aside>
    )}

    {d.kind === 'explainer' && toc.length > 2 && (
      <nav class="toc">
        <div class="label mono">{s.contents}</div>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}

    <div class="prose">
      <Content />
    </div>

    <aside class="opinion">
      <div class="who">
        <img src="https://aibriefing.dev/koby-almog.jpg" alt="" width="44" height="44" />
        <div><div class="n">{lang === 'he' ? 'קובי אלמוג' : 'Koby Almog'}</div><div class="r">{s.opinionLabel}</div></div>
      </div>
      <div class="body"><Fragment set:html={opinionHtml} /></div>
    </aside>

    <section class="sources">
      <h2 class="mono">{s.sourcesLabel}</h2>
      <ol>
        {d.sources.map((src) => (
          <li><a href={src.url} rel="noopener noreferrer" target="_blank" dir="ltr">{src.title}</a>{src.date && <span class="d"> · {src.date}</span>}</li>
        ))}
      </ol>
    </section>

    <p class="made-with">{s.madeWith.replace('{n}', String(d.madeWith.sourceCount))}</p>

    {d.series && <SeriesNav lang={lang} post={post} />}
  </main>

  {related.length > 0 && (
    <section class="wrap-wide more-terms">
      <div class="section-head"><h2>{s.more}</h2><a class="mono" href={lang === 'he' ? '/' : '/en/'}>{s.allTerms} →</a></div>
      <PostList lang={lang} posts={related} />
    </section>
  )}
</Base>
