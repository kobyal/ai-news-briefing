direction: down
intent: Intent and done-state
prompt: Prompt
context: Context (files, docs, history)
harness: Harness (tools, permissions)
agent: Agent
check: Check (tests, exit code, schema)
done: Done
reset: New session
intent -> prompt: written down
prompt -> agent
context -> agent: loaded
harness -> agent: allowed actions
agent -> check: runs
check -> agent: fail, iterate
check -> done: pass
agent -> reset: context full or stuck
reset -> prompt: clean restart
