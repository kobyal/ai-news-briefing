direction: right
map: "Map customer env (IdP, data boundary, approvals)"
provision: "Provision env (Terraform + Helm, SSO, secrets)"
evals: "Evals on real customer cases"
deploy: "Governed deploy (read-only tools)"
shadow: "Shadow mode (2 weeks)"
handoff: "Handoff (outcome metric + runbook)"
product: "Product team generalizes"
map -> provision: blockers first
provision -> evals: rebuildable env
evals -> deploy: score >= threshold
evals -> provision: exit 1
deploy -> shadow: decisions logged, not executed
shadow -> evals: every disagreement = new case
shadow -> handoff: sign-off
handoff -> product: repeated patterns
