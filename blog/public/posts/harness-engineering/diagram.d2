direction: right
task: Task spec
planner: Planner
generator: Generator agent
tools: Tools and sandbox
verifier: Verifier (tests, lint, evaluator)
artifacts: Progress artifacts
rules: Harness rules
task -> planner: spec
planner -> generator: feature list
generator -> tools: edit / run
tools -> verifier: output
verifier -> generator: fail + feedback
verifier -> artifacts: pass
artifacts -> generator: next session context
verifier -> rules: repeated mistake
rules -> generator: new constraint
