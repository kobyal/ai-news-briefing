direction: down
user: "User (UI)"
agent: "Agent (MCP)"
registry: "Action registry"
gate: "Approval gate"
db: "App state (DB)"
audit: "Audit log"
user -> registry: click
agent -> registry: tool call
registry -> gate: irreversible
gate -> db: approved
registry -> db: reversible
db -> audit: receipt
audit -> agent: readable state
