direction: right
user: "You"
page: "Untrusted page (Reddit comment)"
assistant: "Comet Assistant"
model: "LLM"
actions: "Agent actions"
session: "Your browser session (cookies, logins)"
other: "Other logged-in site"
user -> assistant: "summarize this page"
page -> assistant: "hidden instructions"
assistant -> model: "page text + request"
model -> actions: "next step"
actions -> session: "acts as you"
session -> other: "authenticated request"
other -> actions: "private data"
actions -> page: "data posted back"
