---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from './PostList.astro';
import { fmtDate, postHref, readingMinutes, t, type Lang } from '../lib/i18n';
import { marked } from 'marked';

interface Props { lang: Lang; post: CollectionEntry<'posts'> }
const { lang, post } = Astro.props;
const s = t(lang);
const d = post.data;
const { Content } = await render(post);
const opinionHtml = marked.parse(d.opinion);
const minutes = readingMinutes(post.body ?? '');
const path = postHref(lang, d.key);
const site = 'https://blog.aibriefing.dev';
const related = (await getCollection('posts', (p) => p.data.lang === lang && !p.data.draft && p.data.key !== d.key))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  inLanguage: lang === 'he' ? 'he-IL' : 'en-US',
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  image: d.hero ? site + d.hero : undefined,
  url: site + path,
  author: { '@type': 'Person', name: 'Koby Almog', url: 'https://aibriefing.dev/about/', image: 'https://aibriefing.dev/koby-almog.jpg' },
  publisher: { '@type': 'Organization', name: 'AI Briefing', url: 'https://aibriefing.dev' },
  keywords: [d.term, ...d.tags].join(', '),
  citation: d.sources.map((x) => x.url),
};
---
<Base lang={lang} title={`${d.title} — AI Briefing Blog`} description={d.description} image={d.hero} type="article" jsonLd={jsonLd}>
  <main class="wrap article">
    <div class="byline mono"><span class="term">{d.term}</span><span class="dot">·</span><span>{fmtDate(d.pubDate, lang)}</span><span class="dot">·</span><span>{minutes} {s.minutes}</span></div>
    <h1>{d.title}</h1>
    <p class="lede">{d.description}</p>

    {d.hero && !d.video && (
      <div class="cover"><img src={d.hero} alt="" width="1200" height="630" /></div>
    )}

    {d.video && (
      <div class="video-wrap">
        <video controls preload="metadata" poster={d.videoPoster ?? d.hero} playsinline>
          <source src={d.video} type="video/mp4" />
        </video>
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    <aside class="opinion">
      <div class="label mono">{s.opinionLabel}</div>
      <Fragment set:html={opinionHtml} />
    </aside>

    <section class="sources">
      <h2 class="mono">{s.sourcesLabel}</h2>
      <ol>
        {d.sources.map((src) => (
          <li><a href={src.url} rel="noopener noreferrer" target="_blank" dir="ltr">{src.title}</a>{src.date && <span class="d"> · {src.date}</span>}</li>
        ))}
      </ol>
    </section>

    <p class="made-with">{s.madeWith.replace('{n}', String(d.madeWith.sourceCount))}</p>

    <div class="author">
      <img src="https://aibriefing.dev/koby-almog.jpg" alt="Koby Almog" width="60" height="60" />
      <div>
        <div class="n">{lang === 'he' ? 'קובי אלמוג' : 'Koby Almog'}</div>
        <div class="r">{s.authorRole} · <a href="https://aibriefing.dev/about/">{s.about}</a></div>
      </div>
    </div>
  </main>

  {related.length > 0 && (
    <section class="wrap-wide more-terms">
      <div class="section-head"><h2>{s.more}</h2><a class="mono" href={lang === 'he' ? '/' : '/en/'}>{s.allTerms} →</a></div>
      <PostList lang={lang} posts={related} />
    </section>
  )}
</Base>
